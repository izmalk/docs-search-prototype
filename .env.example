# OpenSearch connection details — populated by scripts/fetch-credentials.sh
# after `terraform apply`. Copy to .env and fill in, or run the fetch script.

OPENSEARCH_HOST=
OPENSEARCH_PORT=9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
# Self-signed TLS from the self-signed-certificates charm — do not verify.
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX=sphinx-docs
